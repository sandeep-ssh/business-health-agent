# Business Health Agent — Environment Variables
# Copy to config/.env and fill in your values

# ── LangSmith (tracing + evals) ───────────────────────────────────
LANGSMITH_API_KEY=l<angsmith_api_key>
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=business-health-agent

# ── LLM — choose ONE ─────────────────────────────────────────────

# Option A: Anthropic Claude (recommended — easiest to get started)
ANTHROPIC_API_KEY=<your_anthropic_key>
ANTHROPIC_MODEL=claude-sonnet-4-5

# Option B: Azure OpenAI (uncomment + comment out Option A above)
# AZURE_OPENAI_API_KEY=your_azure_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-02-01

# Option C: OpenAI direct (uncomment + comment out Option A above)
# OPENAI_API_KEY=your_openai_key
# OPENAI_MODEL=gpt-4o
